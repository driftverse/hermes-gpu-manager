# The GPU Ollama instance. Same binary, models and settings as the old hermes-ollama.service, moved to port 11436.
# The manager decides which models live here; nothing should talk to this port directly except the manager and router.
[Unit]
Description=Hermes Ollama (GPU instance, loopback only)
After=network.target

[Service]
Type=simple
ExecStart=/home/example/.local/ollama/bin/ollama serve
Environment=OLLAMA_HOST=127.0.0.1:11436
Environment=OLLAMA_MODELS=/home/example/.ollama/models
# llama.cpp keeps this much VRAM (MiB) free when fitting a model; the default 1024 stopped LFM3 at a 100k window
# (needs ~2.36 GiB) from loading fully on this 4 GB card. 512 still leaves a margin for the desktop.
Environment=LLAMA_ARG_FIT_TARGET=512
# Explicit CUDA12 backend for Pascal support in the bundled llama-server.
Environment=LD_LIBRARY_PATH=/home/example/.local/ollama/lib/ollama:/home/example/.local/ollama/lib/ollama/cuda_v12
Environment=GGML_BACKEND_PATH=/home/example/.local/ollama/lib/ollama/cuda_v12/libggml-cuda.so
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
